# 本地联调地址:cp .env.example .env 后生效,这份 .env 不进 git
# 对话网页(DeepSeek-Chat-Enhanced 一侧)的本地地址
DS_CHAT_PAGES_LINK=http://127.0.0.1:61117
# 本合集的本地发布目录地址:构建产物 dist/pages 起一个静态服务时监听这里
AWESOME_DSC_HUMANIZE_ASSET_PAGES_LINK=http://127.0.0.1:61121

# 联调构建用:把作者站点基址指到本地静态目录,scripts/build-from-catalog.mjs 按 catalog 里的 base_url 拉取
# 只在本地临时改 catalog 登记时使用,不要提交到登记文件
ASSET_AUTHOR_SITE_BASE=http://127.0.0.1:61122/

# 本地 npm registry 模拟器(组织仓库 tools/dev-local-npmjs,端口 61116;只有 awesome 与 inner 的收录校验读取)
# 真实环境变量优先于 .env:命令行 --registry 优先级最高,其次是环境变量 NPM_REGISTRY_URL
NPM_REGISTRY_URL=http://127.0.0.1:61116/
